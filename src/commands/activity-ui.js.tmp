async function handleHelp(ctx) {
  return send(ctx, { embeds: [embed('VOID // command directory', '**STAFF ACTIVITY**\n`$modstats view [@user]` — today’s activity and all-time totals\n`$modstats history [@user]` — detailed daily records\n`$modstats leaderboard` — Today, 7 days, 14 days, all time, or custom range\n`$modstats setup` — setup and requirement status\n`$modstats reset @user|all` — reset today’s counters (manager)\n\n**TRACKING CONFIGURATION**\n`$modstats channel add/remove/list #channel`\n`$modstats voicechannel add/remove/list #channel`\n`$modstats afk set #channel|disable`\n`$modstats requirement messages|voice <amount>`\n`$modstats defaulttimezone <IANA>`\n`$modstats audit #channel`\n`$modstats permissions add/remove @role`\n`$modstats restrict on|off`\n\n**TIMEZONES**\n`$tz` — show local time\n`$tz Asia/Dhaka` — set your timezone\n`$tz @user` — show another member’s timezone\n`$tz list` · `$tz reset`\n\n**STAFF ROLES**\n`$staffrole add/remove/list/setorder/config @role`\n`$promote @member` · `$demote @member` · `$strip @member`\n\n**ROLE & ROSTER**\n`$inrole @role` · `$roleposition @role` · `$rolereposition @role <position>`\n`$staffroster [@role]`\n`$setup` · `$config show|reset`\n\n**ACTIVITY POINTS**\nEach counted message = 1 point · Each voice minute = 1 point\nThe shared daily target is the higher of the message and voice requirements.\n\nEquivalent slash commands are available.')] });
}